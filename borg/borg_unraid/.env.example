# ============================================================
# Borgmatic Environment Variables
# ============================================================
# Copy this file to .env and customize with your settings
#
# IMPORTANT: Keep this file secure!
# - Set permissions: chmod 600 .env
# - Never commit to version control
# - Back up offline in a secure location
# ============================================================

# ============================================================
# BORG PASSPHRASE (REQUIRED)
# ============================================================
# Your repository encryption passphrase
# This is used to encrypt your backups
#
# Requirements:
# - Use a STRONG passphrase (20+ characters recommended)
# - Mix of letters, numbers, and symbols
# - Store securely (password manager, encrypted USB, etc.)
# - You NEED this to access backups!
#
# CRITICAL: You must have BOTH the passphrase AND the
# repository key file to restore backups. Export the key
# with: docker exec borgmatic borg key export /mnt/borg-repository /tmp/repo.key
#
BORG_PASSPHRASE=changeme-to-strong-passphrase-here

# ============================================================
# TIMEZONE
# ============================================================
# Set your timezone for accurate backup timestamps
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# Common examples:
#   America/New_York
#   America/Chicago
#   America/Denver
#   America/Los_Angeles
#   America/Phoenix
#   Europe/London
#   Europe/Paris
#   Asia/Tokyo
#   Australia/Sydney
#
TZ=America/Los_Angeles

# ============================================================
# OPTIONAL: CUSTOM SSH SETTINGS
# ============================================================
# Uncomment and customize if using remote backups with
# non-standard SSH configuration
#
# Custom SSH command (for specific key, port, etc.)
# BORG_RSH=ssh -i /root/.ssh/id_ed25519 -p 22

# Allow relocated repository access (usually leave as 'no')
# BORG_RELOCATED_REPO_ACCESS_IS_OK=no

# Allow unknown unencrypted repository access (leave as 'no' for security)
# BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=no

# ============================================================
# OPTIONAL: NOTIFICATION SERVICES
# ============================================================
# Add credentials for notification services if desired

# Healthchecks.io (uncomment and add your UUID)
# HEALTHCHECKS_URL=https://hc-ping.com/YOUR-UUID-HERE

# Cronitor (uncomment and add your keys)
# CRONITOR_PING_URL=https://cronitor.link/p/YOUR-KEY/YOUR-JOB-ID

# PagerDuty (uncomment and add your integration key)
# PAGERDUTY_INTEGRATION_KEY=YOUR_INTEGRATION_KEY

# Email notification settings (if using mail command)
# NOTIFICATION_EMAIL=you@example.com

# Ntfy notification server (self-hosted push notifications)
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=borg-backup
# NTFY_USERNAME=your-username
# NTFY_PASSWORD=your-password

# ============================================================
# OPTIONAL: ADVANCED SETTINGS
# ============================================================
# Only change these if you know what you're doing

# Borg lock timeout (seconds to wait if repository is locked)
# BORG_LOCK_WAIT=5

# Checkpoint interval (for very large backups)
# BORG_CHECKPOINT_INTERVAL=1800

# Logging level (ERROR, WARNING, INFO, DEBUG)
# BORG_LOGGING_LEVEL=INFO

# ============================================================
# SECURITY NOTES
# ============================================================
# 1. Set file permissions after creating .env:
#    chmod 600 .env
#    chown nobody:users .env
#
# 2. NEVER commit this file to git/version control
#    (add .env to your .gitignore)
#
# 3. Back up your passphrase to multiple secure locations:
#    - Password manager (1Password, Bitwarden, etc.)
#    - Encrypted USB drive stored off-site
#    - Printed and stored in safe
#
# 4. Export and save repository key separately:
#    docker exec borgmatic borg key export /mnt/borg-repository /tmp/repo.key
#    docker cp borgmatic:/tmp/repo.key ./borg-local-repo.key
#    Store this key file in the same secure locations
#
# 5. Test recovery periodically:
#    - Verify you can access backups with passphrase + key
#    - Practice restoring files on a test system
#
# ============================================================
# QUICK START
# ============================================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env and set your passphrase:
#    nano .env
#
# 3. Set secure permissions:
#    chmod 600 .env
#
# 4. Start the container:
#    docker-compose up -d
#
# 5. Initialize the repository:
#    docker exec borgmatic borgmatic init --encryption repokey
#
# 6. Export and save the repository key:
#    docker exec borgmatic borg key export /mnt/borg-repository /tmp/repo.key
#    docker cp borgmatic:/tmp/repo.key ./borg-local-repo.key
#    chmod 600 borg-local-repo.key
#
# 7. Run your first backup:
#    docker exec borgmatic borgmatic --verbosity 1 --stats
#
# 8. CRITICAL: Save offline backups of:
#    - This .env file (or at least the passphrase)
#    - The borg-local-repo.key file
#    Store in password manager, encrypted USB, etc.
#
# ============================================================
